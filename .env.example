# Prefer pnpm setup:local to generate independent ignored secrets.
APP_ENV=local
DATA_ENV=test
PAYMENT_MODE=fixture
PAI_MODE=fixture
GRAML_MODE=fixture
# Docker PostgreSQL bootstrap password must match DIRECT_DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
DATABASE_URL=postgresql://goober_runtime:REPLACE@127.0.0.1:54329/goober
DIRECT_DATABASE_URL=postgresql://goober_migrator:REPLACE@127.0.0.1:54329/goober
REDIS_URL=redis://127.0.0.1:6389
BETTER_AUTH_URL=http://127.0.0.1:3000
TRUSTED_ORIGIN=http://127.0.0.1:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
FIXTURE_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
DELIVERY_KEY_ID=local-v1
DELIVERY_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
DISPATCH_PAUSED=false
PAI_FIXTURE_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_TEST_SECRET
# Paystack configuration (use test keys sk_test_... / pk_test_... during development; keep secret key server-only)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_TEST_SECRET
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_PAYSTACK_TEST_PUBLIC_KEY
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/wallet
PAYSTACK_WEBHOOK_URL=http://127.0.0.1:3000/api/v1/webhooks/paystack
PAYSTACK_USD_ENABLED=false
# Centralized exchange-rate service configuration
EXCHANGE_RATE_PROVIDER_URL=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_MAX_AGE_MS=86400000

