# Production deployment template. Keep these values in the hosting provider's secret store.
APP_ENV=production
DATA_ENV=live
PAYMENT_MODE=paystack
PAI_MODE=disabled
GRAML_MODE=disabled
DATABASE_URL=REPLACE_WITH_POOLED_POSTGRES_URL
DIRECT_DATABASE_URL=REPLACE_WITH_DIRECT_POSTGRES_URL
REDIS_URL=REPLACE_WITH_TLS_REDIS_URL
BETTER_AUTH_URL=https://YOUR_WEB_DOMAIN
TRUSTED_ORIGIN=https://YOUR_WEB_DOMAIN
INTERNAL_API_ORIGIN=https://YOUR_API_DOMAIN
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
DELIVERY_KEY_ID=production-v1
DELIVERY_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
DISPATCH_PAUSED=false
# Paystack live credentials are server-only. The public key is optional for server redirects.
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_PAYSTACK_PUBLIC_KEY
PAYSTACK_WEBHOOK_SECRET=whsec_REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
PAYSTACK_CALLBACK_URL=https://YOUR_WEB_DOMAIN/checkout/verify
PAYSTACK_WEBHOOK_URL=https://YOUR_API_DOMAIN/api/v1/webhooks/paystack
PAYSTACK_USD_ENABLED=false
# Centralized exchange-rate service configuration. Configure a provider for live quotes.
EXCHANGE_RATE_PROVIDER_URL=https://YOUR_RATE_PROVIDER
EXCHANGE_RATE_API_KEY=REPLACE_WITH_RATE_PROVIDER_KEY
EXCHANGE_RATE_MAX_AGE_MS=86400000

