{
  "name": "goober",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev:infra": "powershell -NoProfile -File scripts/infra/start.ps1",
    "dev:infra:stop": "powershell -NoProfile -File scripts/infra/stop.ps1",
    "setup:local": "node scripts/setup-local.mjs",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate --config packages/db/prisma.config.ts",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy --config packages/db/prisma.config.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/src/seed.ts",
    "admin:grant": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "dev": "concurrently -k -n web,api,worker \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "node scripts/web.mjs dev",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "start:web": "node scripts/web.mjs start",
    "lint": "eslint apps packages tests scripts --no-warn-ignored",
    "typecheck": "tsc --noEmit && node scripts/web.mjs typegen && tsc --noEmit -p apps/web/tsconfig.json",
    "test:unit": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "node scripts/integration.mjs --e2e",
    "build": "pnpm db:generate && tsc --noEmit && node scripts/web.mjs build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:e2e",
    "db:permissions": "node --env-file-if-exists=.env --import tsx scripts/infra/permissions.ts",
    "auth:schema:check": "node --env-file-if-exists=.env --import tsx scripts/infra/auth-schema.ts",
    "test:clean-checkout": "node scripts/verify-clean-checkout.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@better-auth/prisma-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "bullmq": "6.3.15",
    "ioredis": "6.0.0",
    "lossless-json": "4.3.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1",
    "@goober/db": "workspace:*",
    "@goober/providers": "workspace:*",
    "@goober/commerce": "workspace:*",
    "@goober/contracts": "workspace:*",
    "@goober/auth": "workspace:*"
  }
}
